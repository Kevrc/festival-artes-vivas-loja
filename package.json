{
  "name": "fiavl",
  "private": true,
  "description": "Plataforma del Festival Internacional de Artes Vivas de Loja",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed/index.ts",
    "events:emit": "tsx --env-file-if-exists=.env scripts/emitir-evento.ts",
    "contracts:gen": "pnpm --filter @fiavl/contracts gen",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@fiavl/config": "workspace:*",
    "@fiavl/contracts": "workspace:*",
    "@prisma/client": "6.19.3",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "pg-boss": "^10.4.2",
    "prettier": "^3.10.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
