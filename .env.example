# Copiar a .env y ajustar. Nunca versionar .env (constitución VI).
DATABASE_URL=postgresql://fiavl:fiavl@localhost:5433/fiavl
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3100
REVALIDATE_SECRET=cambia-este-secreto
NEXT_PUBLIC_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Solo desarrollo y E2E: fija la hora de la API (p. ej. 2026-11-14T12:00:00-05:00). Vacío = hora real.
FIAVL_AHORA=
# Boletería (spec 002)
BOLETERIA_PAGOS_PROVEEDOR=simulador
BOLETERIA_QR_PRIVADA_PEM=
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_WEBHOOK_SECRET=secreto-webhook-dev
# Convocatorias (spec 003)
# Opciones: memoria | disco | s3
CONVOCATORIAS_ALMACENAMIENTO=disco
CONVOCATORIAS_DISCO_DIRECTORIO=.almacen-dev
# Opciones: simulador | clamav
CONVOCATORIAS_ANTIVIRUS=simulador
# Resultado solo con el simulador: limpio | infectado | caido
CONVOCATORIAS_ANTIVIRUS_RESULTADO=limpio
CONVOCATORIAS_S3_ENDPOINT=
CONVOCATORIAS_S3_BUCKET=convocatorias
CONVOCATORIAS_S3_ACCESS_KEY=
CONVOCATORIAS_S3_SECRET_KEY=
CONVOCATORIAS_S3_REGION=us-east-1
CONVOCATORIAS_S3_PATH_STYLE=true
CONVOCATORIAS_CLAMAV_HOST=localhost
CONVOCATORIAS_CLAMAV_PORT=3310
